<service>
	<id>protogybackend.exe</id>
	<name>Protogy Backend</name>
	<description>Protogy IoT API + MQTT ingestion + dashboard</description>
	<executable>C:\Program Files\nodejs\node.exe</executable>
	<argument>--harmony</argument>
	<argument>C:\Users\Administrator\documents\protogy\backend\node_modules\node-windows\lib\wrapper.js</argument>
	<argument>--file</argument>
	<argument>C:\Users\Administrator\documents\protogy\backend\server.js</argument>
	<argument>--scriptoptions=</argument>
	<argument>--log</argument>
	<argument>Protogy Backend wrapper</argument>
	<argument>--grow</argument>
	<argument>0.25</argument>
	<argument>--wait</argument>
