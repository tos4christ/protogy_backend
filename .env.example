# Copy to .env and edit
PORT=3000

PGHOST=localhost
PGPORT=5432
PGDATABASE=protogy
PGUSER=postgres
PGPASSWORD=902307

# MQTT broker (EMQX on same box). Use mqtts://host:8883 with certs for remote.
MQTT_URL=mqtts://13.49.101.7:8883
MQTT_CLIENT_ID=protogy-backend
MQTT_TOPIC=meters/SIM-01/data
# Optional mTLS (leave blank for local plaintext listener bound to 127.0.0.1)
MQTT_CA_FILE=C:\protogy\certs\ca.crt
MQTT_CERT_FILE=C:\protogy\certs\server.crt
MQTT_KEY_FILE=C:\protogy\certs\server.key

# Thresholds for uptime computation
VOLTAGE_PRESENT_THRESHOLD=50
CURRENT_PRESENT_THRESHOLD=0.5

# Authentication
JWT_SECRET=RAID20242024$
JWT_TTL=12h

# EMQX webhook shared secret (also set in the EMQX HTTP connector header)
EMQX_WEBHOOK_SECRET=RAID20242024$

# HTTPS (set after running win-acme; leave blank for plain HTTP on PORT)
SSL_CERT_FILE=
SSL_KEY_FILE=
HTTPS_PORT=443
HTTP_REDIRECT_PORT=80
